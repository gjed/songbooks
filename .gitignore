docs/superpowers/
pdf/
raw*.txt
*.docx
.worktrees/
*.zip

# Full-resolution source art — downsampled copies are what's committed
# under songbooks/*/images/; keep originals local for future re-renders.
images-original/

# Spotify OAuth token cache (local only — never commit)
.spotify-token-cache*

# Local Spotify app credentials (never commit)
.env

# Python bytecode cache
__pycache__/

# ChordPro HTML render (built from songbooks/ by `make html`)
html/

# Generated Hugo site (built from songbooks/); site/content/credits.*.md is
# the one hand-authored exception and stays tracked.
site/content/songbooks/
site/content/songpages/
site/content/songs.*.md
site/static/pdf/
site/static/thumbs/
site/assets/songs/
site/public/
site/resources/
.hugo_build.lock
