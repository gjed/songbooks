// ChordPro config for Queen of Saba songbook
// Ukulele, standard tuning G4-C4-E4-A4
// Courier New, 2 columns, one song per page

{
  "include": [ "ukulele" ],

  // Note naming system: common (C D E F G A B)
  "notes": {
    "system": "common",
    "sharp": [ "C", [ "C#", "C♯" ],
               "D", [ "D#", "D♯" ],
               "E",
               "F", [ "F#", "F♯" ],
               "G", [ "G#", "G♯" ],
               "A", [ "A#", "A♯" ],
               "B" ],
    "flat":  [ "C",
               [ "Db", "D♭" ], "D",
               [ "Eb", "E♭" ], "E",
               "F",
               [ "Gb", "G♭" ], "G",
               [ "Ab", "A♭" ], "A",
               [ "Bb", "B♭" ], "B" ]
  },

  // Ukulele standard tuning
  "tuning": [ "G4", "C4", "E4", "A4" ],

  "chords": [
    // Custom chord definitions (common notation, same fingerings as before)
    { "name": "C",     "base": 1, "frets": [ 0, 0, 0, 3 ], "easy": true },
    { "name": "C7",    "base": 1, "frets": [ 0, 0, 0, 1 ], "easy": true },
    { "name": "Dm",    "base": 1, "frets": [ 2, 2, 1, 0 ], "easy": true },
    { "name": "Em",    "base": 1, "frets": [ 0, 4, 0, 2 ], "easy": false },
    { "name": "E7",    "base": 1, "frets": [ 1, 2, 0, 2 ], "easy": true },
    { "name": "F",     "base": 1, "frets": [ 2, 0, 1, 0 ], "easy": true },
    { "name": "Fm",    "base": 1, "frets": [ 1, 0, 1, 3 ], "easy": false },
    { "name": "G",     "base": 1, "frets": [ 0, 2, 3, 2 ], "easy": true },
    { "name": "G7",       "base": 1, "frets": [ 0, 2, 1, 2 ], "easy": true },
    { "name": "G7sus2",   "base": 1, "frets": [ 0, 2, 1, 0 ], "easy": true },
    { "name": "C/G",      "base": 1, "frets": [ 0, 0, 0, 3 ], "easy": true },
    { "name": "C/G7",     "base": 1, "frets": [ 0, 2, 1, 2 ], "easy": true },
    { "name": "Gm7",   "base": 1, "frets": [ 0, 2, 1, 1 ], "easy": true },
    { "name": "Am",    "base": 1, "frets": [ 2, 0, 0, 0 ], "easy": true },
    { "name": "Am7",   "base": 1, "frets": [ 0, 0, 0, 0 ], "easy": true },
    { "name": "Csus2",  "base": 1, "frets": [ 0, 2, 3, 3 ], "easy": false },
    { "name": "C#",     "base": 1, "frets": [ 1, 1, 1, 4 ], "easy": true },
    { "name": "C#m",    "base": 1, "frets": [ 1, 1, 0, 4 ], "easy": false },
    { "name": "A#",     "base": 1, "frets": [ 3, 2, 1, 1 ], "easy": true },
    { "name": "F#",     "base": 1, "frets": [ 3, 1, 2, 1 ], "easy": false },
    { "name": "F#m",    "base": 1, "frets": [ 2, 1, 2, 0 ], "easy": false },
    { "name": "G#m",    "base": 1, "frets": [ 4, 3, 4, 2 ], "easy": false },
    { "name": "Ab",     "base": 3, "frets": [ 3, 1, 2, 1 ], "easy": false },
    { "name": "Dsus4",  "base": 1, "frets": [ 0, 2, 3, 0 ], "easy": false },
    { "name": "Dsus2",  "base": 1, "frets": [ 2, 2, 0, 0 ], "easy": false },
    { "name": "Asus4",  "base": 1, "frets": [ 0, 0, 2, 3 ], "easy": false },
    { "name": "F#7",    "base": 1, "frets": [ 3, 4, 2, 4 ], "easy": false },
    { "name": "D#7",    "base": 1, "frets": [ 3, 3, 3, 4 ], "easy": false },
    { "name": "Dm6",    "base": 1, "frets": [ 2, 2, 1, 2 ], "easy": true },
    { "name": "Bm7b5",  "base": 1, "frets": [ 2, 2, 1, 2 ], "easy": true },
    { "name": "Bdim",   "base": 1, "frets": [ 1, 2, 1, 2 ], "easy": true },
    { "name": "G#dim",  "base": 1, "frets": [ 1, 2, 1, 2 ], "easy": true },
    { "name": "A#dim",  "base": 1, "frets": [ 0, 1, 0, 1 ], "easy": true },
    { "name": "A7/5b",  "base": 1, "frets": [ 2, 3, 3, 4 ], "easy": false },
    { "name": "C#7",    "base": 1, "frets": [ 1, 1, 1, 2 ], "easy": false },
    { "name": "C#m7",   "base": 1, "frets": [ 1, 1, 0, 2 ], "easy": false },
    { "name": "G#m7b5", "base": 1, "frets": [ 1, 2, 2, 2 ], "easy": false },
    { "name": "E/B",    "base": 1, "frets": [ 1, 4, 0, 2 ], "easy": false },
    { "name": "E/G#",   "base": 1, "frets": [ 1, 4, 2, 3 ], "easy": false },
    { "name": "N.C.",   "base": 1, "frets": [ -1, -1, -1, -1 ] }
  ],

  "settings": {
    "columns": 2,
    "chordnames": "strict"
  },

  "pdf": {
    "pagealign-songs": 0,
    // Every TOC ChordPro renders is followed by a forced blank page so the
    // next section starts on an odd/even page for double-sided printing
    // (see ChordPro::Output::PDF generate_songbook). This project prints
    // single-sided and never uses ChordPro's own front-matter/back-matter/
    // title options (covers are merged in separately via make-cover.py +
    // Ghostscript), and pagealign-songs above already disables the only
    // other place this flag would touch song pagination — so turning it
    // off here removes the TOC blank pages with no effect on songs.
    "even-odd-pages": 0,
    "fonts": {
      "text":    { "file": "/usr/share/fonts/truetype/msttcorefonts/cour.ttf",   "size": 11 },
      "chord":   { "file": "/usr/share/fonts/truetype/msttcorefonts/cour.ttf", "size": 11, "color": "blue" },
      "title":   { "file": "/usr/share/fonts/truetype/msttcorefonts/courbd.ttf", "size": 12 },
      "comment": { "file": "/usr/share/fonts/truetype/msttcorefonts/couri.ttf",  "size": 9 }
    },
    "columnspace": 15,
    "headspace": 30,
    "margintop": 40,
    "spacing": {
      "title": 0.8,
      "chords": 1.0
    }
  },

  "diagrams": {
    "show": "all",
    "sorted": true,
    "suppress": [ "C/G7", "C/G", "D/F#", "Bm/F#", "G/B", "F/E", "F/Eb",
      "Dm7/C", "Bb/F", "A#/D", "D6/9", "Em9", "Dmaj9",
      "Am/B", "Am/C", "Am/D", "C/E", "D/A", "G/F#", "Am/E",
      "Gsus", "Dsus", "Cm6", "F/C", "A#m" ]
  }
}
